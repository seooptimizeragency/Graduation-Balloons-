---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const siteName = "Balloons Lane";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎈</text></svg>" />
  </head>
  <body>
    <div class="topbar">
      <div class="container">
        <span>📞 <a href="tel:+17186752820">718-675-2820</a> &nbsp;·&nbsp; ✉️ <a href="mailto:balloonlaneny@gmail.com">balloonlaneny@gmail.com</a></span>
        <span class="hours">Mon–Sat 9am–8pm · Sun 10am–6pm</span>
      </div>
    </div>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <span class="brand-mark">🎈</span>
          <span class="brand-name">Balloons <span>Lane</span></span>
        </a>
        <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/catalog/">Catalog</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a class="btn btn-gold btn-nav" href="/contact/">Get a Quote</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href="/">
              <span class="brand-mark">🎈</span>
              <span class="brand-name" style="color:#fff">Balloons <span>Lane</span></span>
            </a>
            <p>Premium graduation balloons, arches, bouquets, columns and event decor. Custom designs in your school colors — delivered across New Jersey and New York City.</p>
            <div class="socials">
              <a href="https://www.facebook.com/" aria-label="Facebook" title="Facebook">f</a>
              <a href="https://www.instagram.com/" aria-label="Instagram" title="Instagram">📸</a>
              <a href="https://www.pinterest.com/" aria-label="Pinterest" title="Pinterest">📌</a>
              <a href="https://twitter.com/" aria-label="Twitter" title="Twitter">𝕏</a>
              <a href="https://www.youtube.com/" aria-label="YouTube" title="YouTube">▶</a>
              <a href="https://www.tiktok.com/" aria-label="TikTok" title="TikTok">♪</a>
            </div>
          </div>
          <div>
            <h4>Learn More</h4>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/catalog/">Catalog</a></li>
              <li><a href="/blog/">Balloon Blog</a></li>
              <li><a href="/terms/">Terms &amp; Conditions</a></li>
              <li><a href="/privacy/">Privacy Policy</a></li>
            </ul>
          </div>
          <div>
            <h4>Store Hours</h4>
            <ul>
              <li>Monday – Saturday</li>
              <li>9:00 am – 8:00 pm</li>
              <li>Sunday</li>
              <li>10:00 am – 6:00 pm</li>
            </ul>
          </div>
          <div>
            <h4>Contact Info</h4>
            <ul>
              <li>📞 <a href="tel:+17186752820">718-675-2820</a></li>
              <li>✉️ <a href="mailto:balloonlaneny@gmail.com">balloonlaneny@gmail.com</a></li>
              <li>📍 New Jersey &amp; New York City</li>
              <li>🛵 Same-day local delivery available</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="container">
          <span>© 2025 Balloons Lane. All rights reserved.</span>
          <span>Made with ❤ by Balloons Lane</span>
        </div>
      </div>
    </footer>

    <a class="wa-float" href="https://wa.me/17184270968" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">💬</a>
    <script>
      const menuBtn = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.nav');
      if (menuBtn && nav) {
        menuBtn.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          menuBtn.classList.toggle('active', open);
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        });
        nav.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            nav.classList.remove('open');
            menuBtn.classList.remove('active');
            menuBtn.setAttribute('aria-expanded', 'false');
            menuBtn.setAttribute('aria-label', 'Open menu');
          });
        });
      }
    </script>
  </body>
</html>
