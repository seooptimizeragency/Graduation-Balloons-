---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact & Get a Quote"
  description="Get a free quote for graduation balloons, arches, bouquets and event decor. Call 718-675-2820 or send the quote form — same-day local delivery across NJ & NYC."
>
  <section class="post-hero">
    <div class="container center">
      <p class="kicker" style="color:var(--gold)">Contact</p>
      <h1>Get Your Free Quote Today</h1>
      <p class="meta">Share your date, school colors and party size — we'll reply with an estimate.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="form-card">
        <!-- Connect this form to Formspree (formspree.io) or Netlify Forms to receive submissions by email -->
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
          <div class="form-row">
            <div class="field">
              <label for="name">Your Name *</label>
              <input id="name" name="name" type="text" required placeholder="Jane Smith" />
            </div>
            <div class="field">
              <label for="phone">Phone *</label>
              <input id="phone" name="phone" type="tel" required placeholder="(555) 123-4567" />
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="date">Event Date *</label>
              <input id="date" name="date" type="date" required />
            </div>
            <div class="field">
              <label for="guests">Approx. Guests</label>
              <select id="guests" name="guests">
                <option>Under 25</option>
                <option>25 – 50</option>
                <option>50 – 100</option>
                <option>100+</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="service">What do you need? *</label>
            <select id="service" name="service" required>
              <option>Balloon Arch / Garland</option>
              <option>Balloon Columns</option>
              <option>Bouquets &amp; Centerpieces</option>
              <option>Photo Backdrop</option>
              <option>Full Event Package</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Tell us about your event</label>
            <textarea id="message" name="message" rows="4" placeholder="School colors, theme, venue address, pickup or delivery…"></textarea>
          </div>
          <button class="btn btn-gold" type="submit" style="width:100%">Request My Free Quote 🎈</button>
          <p style="font-size:0.85rem;color:var(--muted);margin-top:14px;text-align:center">Prefer to talk? Call <a href="tel:+17186752820" style="color:var(--gold-dark);font-weight:700">718-675-2820</a> or <a href="https://wa.me/17184270968" style="color:var(--gold-dark);font-weight:700">WhatsApp us</a>.</p>
        </form>
      </div>

      <div class="grid-3" style="margin-top:48px">
        <div class="quote-card center">
          <h3 style="color:var(--navy)">📞 Call Us</h3>
          <p><a href="tel:+17186752820" style="font-weight:700;color:var(--gold-dark)">718-675-2820</a></p>
          <p style="font-size:0.9rem">Mon–Sat 9am–8pm · Sun 10am–6pm</p>
        </div>
        <div class="quote-card center">
          <h3 style="color:var(--navy)">✉️ Email</h3>
          <p><a href="mailto:balloonlaneny@gmail.com" style="font-weight:700;color:var(--gold-dark)">balloonlaneny@gmail.com</a></p>
          <p style="font-size:0.9rem">We reply within 24 hours</p>
        </div>
        <div class="quote-card center">
          <h3 style="color:var(--navy)">📍 Areas</h3>
          <p style="font-weight:700">New Jersey &amp; NYC</p>
          <p style="font-size:0.9rem">Newark · Jersey City · Princeton · Manhattan · Brooklyn · Staten Island</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
